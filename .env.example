# EasyMED environment variables
# Copy this file to .env and fill in your values.
# Never commit your actual .env file to version control.

# Required: your OpenAI-compatible API key
EASYMED_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: custom base URL (leave blank to use the default OpenAI endpoint)
EASYMED_BASE_URL=https://api.openai.com/v1

# Optional: model name (defaults to gpt-4o)
EASYMED_MODEL=gpt-4o
